# ============================================================
# TierTagger API - Variáveis de Ambiente (.env.example)
# Copie para .env e ajuste os valores
# ============================================================

# Porta HTTP (Railway injeta PORT automaticamente)
SPRING_PROFILES_ACTIVE=prod

# ============================================================
# PostgreSQL
# ============================================================
DB_URL=jdbc:postgresql://postgres.railway.internal:5432/railway
DB_USERNAME=postgres
DB_PASSWORD=EscNCRfmkIKHuAAbNgAMyWEGYuIdZCZq
DB_DRIVER=org.postgresql.Driver

# ============================================================
# Segurança / JWT
# Use uma chave com pelo menos 32 bytes (256 bits).
# Gerar: openssl rand -base64 64
# ============================================================
JWT_SECRET=4Qv7D8kM2wLxP9eT6nYbF3aR8uHjC5sZ1xWmN0qLpV7kJsE2rTyU9iOoP4dFaG8n
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ============================================================
# Admin padrão (criado somente se ainda não existir)
# ============================================================
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=otavio280914
SEED_ADMIN_DISPLAY=Administrador

# ============================================================
# CORS - Origem dos mods / sites
# Separe múltiplas origens por vírgula
# ============================================================
CORS_ALLOWED_ORIGINS=*

# ============================================================
# Versão atual do cliente (usada para verificação de atualização)
# ============================================================
APP_VERSION=1.0.0
CLIENT_LATEST_VERSION=1.0.0
CLIENT_DOWNLOAD_URL=

# ============================================================
# Logs
# ============================================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_TIERTAGGER=DEBUG

